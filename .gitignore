# Archivos de entorno (credenciales)
.env
*.env
!.env.example

# Entorno virtual de Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Directorios de dependencias (si usas Node/Deno con node_modules)
node_modules/

# Archivos de subida de usuarios (cargas académicas)
# ATENCIÓN: *.xlsx / *.xls / *.csv / *.tsv / *.zip bloquean TODOS los archivos
# con esas extensiones en cualquier ruta del repo. Son artefactos generados o
# datos de prueba con información personal. No se commitean.
uploads/
*.xlsx
*.xls

# Reportes generados por el backend (CSVs y ZIPs)
reports/
*.zip
*.csv
*.tsv

# Datos de las herramientas del operador (backend/tools/): contienen
# información personal real (usernames, cédulas, correos). Local únicamente.
backend/tools/data/

# Certificados y llaves (no se comitean)
certs/*
!certs/README.md
!certs/generate-dev-certs.sh
*.pem
*.key

# Archivos de configuración de IDE y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Base de datos SQLite (si se usa para desarrollo local)
*.db
*.sqlite3

# Archivos de construcción de Fresh (build output)
_fresh/

# Herramientas de coverage, linting y build
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage
dist/
build/
*.egg-info/

# ---------------------------------------------------------------------------
# e2e — pruebas de integración contra Moodle real
# Los fixtures (*.xlsx) contienen datos reales de docentes: son LOCALs,
# cada integrador coloca los suyos en backend/e2e/fixtures/. Solo se
# commitean scripts .py y documentación.
# ---------------------------------------------------------------------------