# Archivos de entorno (credenciales)
.env
*.env
!.env.example

# Entorno virtual de Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Directorios de dependencias (si usas Node/Deno con node_modules)
node_modules/

# Archivos de subida de usuarios (cargas académicas)
uploads/
*.xlsx
*.xls
!backend/tests_e2e/fixtures/*.xlsx

# Reportes generados por el backend (CSVs y ZIPs)
reports/
*.zip
*.csv

# Certificados SSL para producción (no se comitean)
certs/

# Archivos de configuración de IDE y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

# Base de datos SQLite (si se usa para desarrollo local)
*.db
*.sqlite3

# Archivos de construcción de Fresh (build output)
_fresh/

# ---------------------------------------------------------------------------
# tests_e2e — pruebas de integración contra Moodle real
# Los *.xlsx en fixtures contienen datos reales de docentes.
# Los scripts .py y README.md se comitean.
# ---------------------------------------------------------------------------