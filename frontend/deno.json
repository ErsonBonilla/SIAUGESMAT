{
  "lock": true,
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check main.ts dev.ts fresh.config.ts && deno check routes/ && deno check islands/ && deno check components/ && deno check utils/ && deno check services/ && deno check hooks/",
    "start": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "preview": "deno serve -A --port $PORT _fresh/server.js",
    "test": "deno test -A tests/"
  },
  "imports": {
    "fresh": "jsr:@fresh/core@^2.3.3",
    "fresh/dev": "jsr:@fresh/core@^2.3.3/dev",
    "@fresh/core": "jsr:@fresh/core@^2.3.3",
    "@fresh/core/dev": "jsr:@fresh/core@^2.3.3/dev",
    "@fresh/plugin-tailwind": "jsr:@fresh/plugin-tailwind@^1.0.0",
    "preact": "npm:preact",
    "preact/hooks": "npm:preact/hooks",
    "preact/jsx-runtime": "npm:preact/jsx-runtime",
    "preact/jsx-dev-runtime": "npm:preact/jsx-dev-runtime",
    "@preact/signals": "npm:@preact/signals",
    "@preact/signals-core": "npm:@preact/signals-core",
    "chart.js": "https://esm.sh/chart.js@4.4.1",
    "date-fns": "npm:date-fns",
    "preact-render-to-string": "npm:preact-render-to-string",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "nodeModulesDir": "auto"
}
