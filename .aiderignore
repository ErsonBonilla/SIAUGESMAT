# ============================================================
# .aiderignore - LOCAL para SIAUGESMAT
# ============================================================
# Este archivo se COMBINA con el global (C:\Users\erson\.aiderignore).
# Solo añade patrones específicos de este proyecto.
# ============================================================

# ========================
# ENTORNOS VIRTUALES Y CACHÉS DEL PROYECTO
# ========================
# (Si tienes venv dentro del proyecto, aunque lo recomendable es tenerlo fuera)
/venv/
/.venv/
/backend/.venv/
/frontend/.venv/

# Cachés específicos
/backend/__pycache__/
/frontend/__pycache__/
/backend/.pytest_cache/
/frontend/.deno_cache/

# ========================
# MIGRACIONES DE BASE DE DATOS (Alembic)
# ========================
# Las migraciones son generadas automáticamente y no deben auditarse
/backend/alembic/versions/
/backend/migrations/

# ========================
# TESTS: NO se ignoran a propósito.
# backend/tests/ y frontend/tests/ contienen los tests de contrato que
# protegen la lógica (batch_id, task_id, SQL en español, pureza del
# pipeline...). El modelo DEBE verlos para no romperlos.
# ========================

# ========================
# ARCHIVOS DE CONFIGURACIÓN SENSIBLE
# ========================
# Estos archivos contienen secretos o configuraciones locales
/.env
/.env.*
/backend/.env
/frontend/.env
*.env
*.env.local
*.env.development
*.env.production

# ========================
# ARCHIVOS DE DEPENDENCIAS (bloquean o son muy grandes)
# ========================
/backend/poetry.lock
/backend/requirements.txt
/backend/pyproject.toml   # Opcional: si quieres auditar, quítalo
/frontend/deno.lock
/frontend/package.json   # Opcional
/frontend/package-lock.json
/Cargo.lock               # Si usas Rust en algún módulo

# ========================
# DIRECTORIOS DE COMPILACIÓN Y DISTRIBUCIÓN
# ========================
/backend/dist/
/backend/build/
/backend/*.egg-info/
/frontend/dist/
/frontend/build/
/frontend/out/

# ========================
# ARCHIVOS DE LOGS Y TEMPORALES
# ========================
*.log
/backend/logs/
/frontend/logs/
*.tmp
*.swp

# ========================
# ARCHIVOS DE DATOS O SUBIDOS (si los hay)
# ========================
/backend/uploads/
/backend/media/
/backend/data/
/frontend/public/uploads/

# ========================
# ARCHIVOS DE DOCKER (locales)
# ========================
# Si tienes volúmenes montados o archivos de datos de contenedores
/docker-data/
/backend/.dockerignore
/frontend/.dockerignore

# ========================
# OTROS ARCHIVOS GENERADOS POR EL PROYECTO
# ========================
# Archivos de reportes generados por el sistema
/backend/reports/
/frontend/reports/
*.csv
*.xlsx
*.xls
*.zip

# Archivos de configuración de IDE (si no los ignoras globalmente)
/.vscode/
/.idea/
/*.code-workspace

# ========================
# ARCHIVOS DEL SISTEMA DE CONTROL DE VERSIONES
# ========================
/.git/
/.gitignore   # No es necesario, pero si quieres ignorarlo, puedes
/.gitattributes
