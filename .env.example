# Base de datos (usadas por docker-compose y desarrollo local)
POSTGRES_DB=siaugesmat
POSTGRES_USER=siaugesmat
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://siaugesmat:changeme@localhost:5432/siaugesmat

# Proyecto
PROJECT_NAME=SIAUGESMAT

# Habilitar login en modalidad PRESENCIAL (default: false)
ALLOW_PRESENCIAL=false

# Moodle - Configuración base (fallback por modalidad)
MOODLE_URL=http://moodle.ejemplo
MOODLE_ADMIN_TOKEN=tu-token-admin
MOODLE_VERSION=3.9

# Moodle - Configuración por modalidad (sobrescribe la base)
MOODLE_URL__PRESENCIAL=http://moodle.presencial.ejemplo
MOODLE_TOKEN__PRESENCIAL=tu-token-presencial
MOODLE_VERSION__PRESENCIAL=3.8

MOODLE_URL__DISTANCIA=https://moodle.distancia.ejemplo
MOODLE_TOKEN__DISTANCIA=tu-token-distancia
MOODLE_VERSION__DISTANCIA=3.9

# JWT (generar una clave segura: openssl rand -hex 32)
JWT_SECRET_KEY=genera-una-clave-segura-aqui
JWT_EXPIRE_MINUTES=60

# CORS (orígenes separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Plantilla genérica para cursos sin PORTAFOLIO
DEFAULT_COURSE_TEMPLATE=PORTAFOLIO_TEMPLATE

# Rate limiting contra Moodle
MOODLE_MAX_REQUESTS_PER_SECOND=5
MOODLE_BURST_SIZE=10

# Umbrales del semáforo de analítica
ANALYTICS_ERROR_THRESHOLD_YELLOW=1.0
ANALYTICS_ERROR_THRESHOLD_RED=5.0
ANALYTICS_MAX_DURATION_YELLOW=3600
ANALYTICS_MAX_DURATION_RED=7200

# Subida de archivos
MAX_UPLOAD_SIZE_MB=50

# Job timeout (segundos) — 8 horas
JOB_TIMEOUT=28800

# Comparación de cursos: antigüedad máxima y de desaparición (segundos)
#   COURSE_MAX_AGE_SECONDS=62208000        # 24 meses
#   COURSE_DISAPPEARED_AGE_SECONDS=46656000 # 18 meses
COURSE_MAX_AGE_SECONDS=62208000
COURSE_DISAPPEARED_AGE_SECONDS=46656000

# Redis
REDIS_URL=redis://localhost:6379/0

# Otros
DEBUG=false
