# Base de datos
POSTGRES_DB=siaugesmat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:0000/siaugesmat

# Moodle - Configuración por modalidad (MOODLE_URL__{MODALIDAD}, MOODLE_TOKEN__{MODALIDAD})
MOODLE_URL__PRESENCIAL=http://moodle.presencial.ejemplo
MOODLE_TOKEN__PRESENCIAL=tu-token-presencial
MOODLE_VERSION__PRESENCIAL=3.8

MOODLE_URL__DISTANCIA=https://moodle.distancia.ejemplo
MOODLE_TOKEN__DISTANCIA=tu-token-distancia
MOODLE_VERSION__DISTANCIA=3.9

# JWT
JWT_SECRET_KEY=genera-una-clave-segura-aqui

# CORS
CORS_ORIGINS=http://localhost:0000,http://localhost:0000

# Plantilla genérica por defecto cuando no existe un PORTAFOLIO para el curso
DEFAULT_COURSE_TEMPLATE=000000

# Otros
DEBUG=false
JOB_TIMEOUT=0000
REDIS_URL=redis://localhost:0000/0
